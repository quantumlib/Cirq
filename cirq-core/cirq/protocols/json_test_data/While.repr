[
    cirq.While(
        [
            cirq.KeyCondition(cirq.MeasurementKey(name='a')),
            cirq.KeyCondition(cirq.MeasurementKey(name='b')),
        ],
        cirq.Y(cirq.NamedQubit('target')),
    ),
    cirq.While(
        cirq.KeyCondition(cirq.MeasurementKey(name='a')),
        cirq.X(cirq.LineQubit(0)),
        cirq.Y(cirq.LineQubit(1)),
    ),
]
