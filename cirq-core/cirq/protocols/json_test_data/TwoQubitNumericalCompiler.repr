cirq.TwoQubitNumericalCompiler(base_gates=(np.array([[(1+0j), 0j, 0j, 0j], [0j, (1+0j), 0j, 0j], [0j, 0j, (1+0j), 0j], [0j, 0j, 0j, (-1+0j)]], dtype=np.dtype('complex128')), np.array([[(1+0j), 0j, 0j, 0j], [0j, (0.7071067811865476+0j), 0.7071067811865475j, 0j], [0j, 0.7071067811865475j, (0.7071067811865476+0j), 0j], [0j, 0j, 0j, (1+0j)]], dtype=np.dtype('complex128'))), base_gate_error_rates=(0.01, 0.05), target_fidelity=0.99999999, max_layers=3, single_qubit_error_rate=0.0, num_restarts=3, maxiter=1000, random_state=5)
