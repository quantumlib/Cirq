#!/usr/bin/env bash

################################################################################
# Runs type checking on the repository using Pyrefly.
#
# Usage:
#     check/typecheck [--flags]
################################################################################

# Get the working directory to the repo root.
thisdir=$(dirname "${BASH_SOURCE[0]:?}") || exit $?
repo_dir=$(git -C "${thisdir}" rev-parse --show-toplevel) || exit $?
cd "${repo_dir}" || exit $?

# Ensure terminal color is reset even if interrupted.
trap 'echo -e -n "\033[0m"' EXIT

source dev_tools/pypath || exit $?

echo -e -n "\033[31m"
pyrefly check "$@"
result=$?
exit "${result}"
